{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/notaire",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/notaire/:chemin*",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/medecin",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/medecin/:chemin*",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/tarif",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/tarif/:chemin*",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/programme",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/programme/:chemin*",
      "destination": "/formation/",
      "permanent": true
    },
    {
      "source": "/equipe",
      "destination": "/#equipe",
      "permanent": true
    },
    {
      "source": "/equipe/:chemin*",
      "destination": "/#equipe",
      "permanent": true
    }
  ]
}
